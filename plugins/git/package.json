{
  "name": "@ovvi/git",
  "version": "1.9.0",
  "private": true,
  "description": "Changes and history",
  "keywords": ["diff", "changes", "commit", "uncommitted", "history"],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --splitting --format=esm --minify --sourcemap --target=safari18 --log-level=warning --outdir=dist",
    "dev": "npm run build -- --watch",
    "check": "tsc -p ."
  },
  "dependencies": {
    "@pierre/diffs": "1.6.2",
    "@pierre/trees": "1.0.0-beta.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@ovvi/plugin-api": "*"
  },
  "peerDependenciesMeta": {
    "@ovvi/plugin-api": { "optional": true }
  },
  "ovvi": {
    "id": "git",
    "name": "Git",
    "api": 3,
    "entry": "dist/main.js",
    "icon": "source.branch",
    "opens": { "git": true },
    "chooser": "Git",
    "permissions": ["files:read", "git", "clipboard"],
    "history": true,
    "settings": [
      { "id": "diff-layout", "type": "choice", "title": "Diff layout", "default": "unified",
        "options": [{ "value": "unified", "title": "Unified" }, { "value": "split", "title": "Side by Side" }] },
      { "id": "wrap", "type": "toggle", "title": "Wrap long lines", "default": false },
      { "id": "file-list", "type": "toggle", "title": "Show the file list when a diff opens", "default": false },
      { "id": "commits", "type": "number", "title": "Commits in the history", "default": 500, "min": 100,
        "max": 5000, "step": 100 }
    ],
    "header": [
      { "type": "menu", "id": "git.branch", "symbol": "source.branch", "title": "—", "label": "Branch",
        "enabled": false, "hidden": true },
      { "type": "button", "id": "diff.home", "symbol": "house", "title": "Git Home", "hidden": true },
      { "type": "button", "id": "git.working", "symbol": "plus.forwardslash.minus", "title": "Working Tree",
        "style": "bordered", "hidden": true },
      { "type": "spacer" },
      { "type": "button", "id": "git.fetch", "symbol": "arrow.clockwise", "title": "Fetch", "style": "bordered",
        "hidden": true },
      { "type": "button", "id": "git.pull", "symbol": "arrow.down", "title": "Pull", "style": "bordered",
        "hidden": true },
      { "type": "button", "id": "git.push", "symbol": "arrow.up", "title": "Push", "style": "bordered",
        "hidden": true },
      { "type": "segmented", "id": "diff.layout", "value": "unified", "hidden": true,
        "options": [{ "value": "unified", "title": "Unified" }, { "value": "split", "title": "Side by Side" }] },
      { "type": "toggle", "id": "diff.wrap", "symbol": "text.wrap", "title": "Word Wrap", "value": false,
        "hidden": true },
      { "type": "button", "id": "diff.file-list", "symbol": "sidebar.left", "title": "Hide File List", "hidden": true },
      { "type": "button", "id": "diff.previous", "symbol": "chevron.up", "title": "Previous Change", "gap": 0,
        "hidden": true },
      { "type": "button", "id": "diff.next", "symbol": "chevron.down", "title": "Next Change", "gap": 0,
        "hidden": true }
    ]
  }
}

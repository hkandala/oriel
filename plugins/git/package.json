{
  "name": "@oriel/git",
  "version": "1.1.0",
  "private": true,
  "description": "Changes and history",
  "keywords": ["diff", "changes", "commit", "uncommitted", "history"],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --splitting --format=esm --minify --sourcemap --target=safari18 --log-level=warning --outdir=dist",
    "dev": "npm run build -- --watch",
    "check": "tsc -p ."
  },
  "dependencies": {
    "@pierre/diffs": "1.6.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@oriel/plugin-api": "*"
  },
  "peerDependenciesMeta": {
    "@oriel/plugin-api": { "optional": true }
  },
  "oriel": {
    "id": "git",
    "name": "Git",
    "api": 1,
    "entry": "dist/main.js",
    "icon": "arrow.triangle.branch",
    "opens": { "git": true },
    "chooser": "Git",
    "permissions": ["files:read", "git", "clipboard"],
    "history": true,
    "header": [
      { "type": "menu", "id": "git.branch", "symbol": "arrow.triangle.branch", "title": "—", "label": "Branch",
        "enabled": false, "hidden": true },
      { "type": "button", "id": "diff.home", "symbol": "house", "title": "Git Home", "hidden": true },
      { "type": "spacer" },
      { "type": "button", "id": "git.fetch", "symbol": "arrow.clockwise", "title": "Fetch", "hidden": true },
      { "type": "button", "id": "git.pull", "symbol": "arrow.down", "title": "Pull", "gap": 2, "hidden": true },
      { "type": "button", "id": "git.push", "symbol": "arrow.up", "title": "Push", "gap": 2, "hidden": true },
      { "type": "segmented", "id": "diff.layout", "value": "unified", "hidden": true,
        "options": [{ "value": "unified", "title": "Unified" }, { "value": "split", "title": "Side by Side" }] },
      { "type": "button", "id": "diff.file-list", "symbol": "sidebar.left", "title": "Hide File List", "hidden": true },
      { "type": "button", "id": "diff.previous", "symbol": "chevron.up", "title": "Previous Change", "gap": 0,
        "hidden": true },
      { "type": "button", "id": "diff.next", "symbol": "chevron.down", "title": "Next Change", "gap": 0,
        "hidden": true }
    ]
  }
}

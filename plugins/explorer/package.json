{
  "name": "@ovvi/explorer",
  "version": "1.10.6",
  "private": true,
  "description": "Files and folders",
  "keywords": ["files", "tree", "folder", "finder"],
  "scripts": {
    "build": "mkdir -p dist && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs node_modules/pdfjs-dist/web/pdf_viewer.css node_modules/pdfjs-dist/wasm/openjpeg.wasm node_modules/pdfjs-dist/wasm/jbig2.wasm node_modules/pdfjs-dist/wasm/qcms_bg.wasm node_modules/pdfjs-dist/standard_fonts/*.pfb node_modules/pdfjs-dist/standard_fonts/*.ttf node_modules/pdfjs-dist/cmaps/*.bcmap dist/ && esbuild src/main.ts --bundle --splitting --format=esm --minify --sourcemap --target=safari18 --log-level=warning --outdir=dist --external:*.svg --external:*.gif",
    "dev": "npm run build -- --watch",
    "check": "tsc -p ."
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@pierre/trees": "1.0.0-beta.6",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@ovvi/plugin-api": "*"
  },
  "peerDependenciesMeta": {
    "@ovvi/plugin-api": { "optional": true }
  },
  "ovvi": {
    "id": "explorer",
    "name": "File Explorer",
    "api": 3,
    "entry": "dist/main.js",
    "icon": "folder",
    "opens": { "folders": true, "files": ["*"] },
    "chooser": "File Explorer",
    "handles": ["save", "find"],
    "history": true,
    "header": [
      { "type": "field", "id": "root", "style": "path", "symbol": "folder", "label": "Root", "hidden": true },
      { "type": "toggle", "id": "filter", "symbol": "magnifyingglass", "title": "Filter", "value": false,
        "hidden": true },
      { "type": "button", "id": "collapse", "symbol": "rectangle.compress.vertical", "title": "Collapse All",
        "hidden": true },
      { "type": "toggle", "id": "hidden-files", "symbol": "eye", "title": "Show Hidden Files", "value": false,
        "hidden": true },
      { "type": "toggle", "id": "outline", "symbol": "sidebar.left", "title": "Outline", "value": false,
        "hidden": true },
      { "type": "text", "id": "jump", "style": "path", "hidden": true },
      { "type": "spacer", "id": "spacer", "hidden": true },
      { "type": "text", "id": "page", "style": "dim", "digits": "mono", "hidden": true },
      { "type": "button", "id": "zoom.fit", "symbol": "arrow.down.right.and.arrow.up.left", "title": "Zoom to Fit",
        "hidden": true },
      { "type": "button", "id": "zoom.actual", "symbol": "1.magnifyingglass", "title": "Actual Size", "gap": 0,
        "hidden": true },
      { "type": "button", "id": "zoom.out", "symbol": "minus.magnifyingglass", "title": "Zoom Out", "gap": 0,
        "hidden": true },
      { "type": "button", "id": "zoom.in", "symbol": "plus.magnifyingglass", "title": "Zoom In", "gap": 0,
        "hidden": true },
      { "type": "toggle", "id": "wrap", "symbol": "text.wrap", "title": "Word Wrap", "value": true, "hidden": true },
      { "type": "button", "id": "reveal", "symbol": "list.bullet.indent", "title": "Show in File Explorer",
        "hidden": true },
      { "type": "segmented", "id": "mode", "value": "rich", "hidden": true,
        "options": [{ "value": "rich", "title": "Rich Text", "symbol": "doc.richtext" },
          { "value": "source", "title": "Source", "symbol": "chevron.left.forwardslash.chevron.right" }] },
      { "type": "toggle", "id": "lock", "symbol": "lock.fill", "title": "Unlock", "value": false, "hidden": true },
      { "type": "openWith", "id": "open-with", "hidden": true }
    ],
    "settings": [
      { "id": "hidden-files", "type": "toggle", "title": "Show hidden files",
        "description": "Names that start with a dot.", "default": false },
      { "id": "ignored", "type": "toggle", "title": "Dim files that Git ignores", "default": true },
      { "id": "markdown", "type": "choice", "title": "Markdown opens in", "default": "rich",
        "options": [{ "value": "rich", "title": "Rich Text" }, { "value": "source", "title": "Source" }] },
      { "id": "markdown-lock", "type": "toggle", "title": "Lock Markdown for reading", "default": true }
    ],
    "commands": [
      { "id": "lock-editing", "title": "Lock Editing", "menu": "view", "key": "cmd+e", "symbol": "lock",
        "keywords": ["markdown", "read", "edit", "unlock"] }
    ]
  }
}
